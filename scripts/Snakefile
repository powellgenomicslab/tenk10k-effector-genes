# --- restricted steps: inputs that are not shared ---------------------------------------
# Only defined with `--config restricted=true` (on Gadi, with the full results tree).
# Otherwise their outputs are taken from the bundle (bundled()). They read raw
# single-cell data, or third-party tables of which only derived results are shared:
# the Crohn's literature gene lists and the Kong et al. 2023 DEG table.
# The locus objects that need individual-level genotypes (GPX1, JAZF1) are built by
# workflow/rules/misc.smk and taken from the bundle here.

if RESTRICTED:

    rule crohns_external_annot:
        input:
            ext("metadata/gencode.v44.gene_type.tsv.gz"),
            ext(
                *[
                    f"{CD}/crohns_relevant_gene_lists/sources/{f}"
                    for f in (
                        "Systematic Review of Crohns Disease Genes.csv",
                        "OT-EFO_0000384-associated-targets-07_04_2026-v26_03.tsv",
                        "liu2023_st8_genes.tsv",
                        "drug_target_genes.txt",
                    )
                ],
            ),
        output:
            CD_ANNOT,
        params:
            script="scripts/8-crohns/prepare_data/1-prepare_external_source_annot_boolean_df.R",
        log:
            log("crohns_external_annot"),
        conda:
            ENV
        shell:
            R

    rule crohns_deg_preprocess:
        input:
            ext("metadata/cell.tsv"),
            ext(
                f"{CD}/deg/kong2023_immune_deg.parquet",
            ),
        output:
            CD_DEG,
            f"{CD}/deg/common_gut_cell_types_with_tenk_revision.txt",
        params:
            script="scripts/8-crohns/deg/1-prepare_crohns_deg_pre-processed.R",
        log:
            log("crohns_deg_preprocess"),
        conda:
            ENV
        shell:
            R

    rule crohns_mr_deg:
        input:
            CD_DEG,
            f"{CD}/postprocess/tenk_crohns_sig.RDS",
        output:
            CD_MR_DEG,
            [f"{CD}/deg/mr_deg_{x}.txt" for x in ("con", "discon", "mixed")],
        params:
            script="scripts/8-crohns/deg/2-mr_deg_comparison_inner_join.R",
        log:
            log("crohns_mr_deg"),
        conda:
            ENV
        shell:
            R

    rule crohns_deg_count:
        input:
            CD_DEG,
            f"{CD}/postprocess/tenk_crohns_sig.RDS",
