RESTRICTED_ITEMS = {"fig_s25"}

AVAILABLE = [k for k in ITEMS if RESTRICTED or k not in RESTRICTED_ITEMS]


def group(prefix):
    return [f for k in AVAILABLE if k.startswith(prefix) for f in ITEMS[k][1]]


localrules: all, figs_m, figs_e, figs_s, tabs_s, targets, manifest, inventory, containerize


rule all:
    input:
        [f for k in AVAILABLE for f in ITEMS[k][1]],


rule figs_m:
    input:
        group("fig_m"),


rule figs_e:
    input:
        group("fig_e"),


rule figs_s:
    input:
        group("fig_s"),


rule tabs_s:
    input:
        group("tab_s"),


for _item in AVAILABLE:

    rule:
        name:
            _item
        localrule: True
        input:
            ITEMS[_item][1],


for _item in set(ITEMS) - set(AVAILABLE):

    rule:
        name:
            _item
        localrule: True
        shell:
            "echo '{rule} needs raw single-cell data: run with --config restricted=true' >&2; exit 1"


rule targets:
    """Print every make target with its manuscript caption."""
    run:
        for k, (caption, _) in ITEMS.items():
            flag = "" if k in AVAILABLE else "  [needs restricted=true]"
            print(f"  make {k.replace('_', '-', 1):9s} {caption}{flag}")


rule manifest:
    """Write the bundle allow-list: every external input of every rule."""
    run:
        with open("config/figure_inputs.txt", "w") as fh:
            fh.write(
                "# Files read by scripts/Snakefile that are not produced by it.\n"
                "# Generated by `make manifest`; do not edit. Lines tagged REVIEW must be\n"
                "# confirmed shareable before scripts/0-preprocess/make_figure_bundle.sh\n"
                "# will include them (--include-review). Tracked files (metadata/,\n"
                "# scripts/) are listed for completeness and are not bundled.\n"
            )
            for p in sorted(EXTERNAL):
                note = EXTERNAL[p]
                fh.write(f"{p}\t# REVIEW: {note}\n" if note else f"{p}\n")


def item_label(k):
    kind, n = k.split("_")
    return {"fig_m": "Fig. ", "fig_e": "ED Fig. ", "fig_s": "Supp. Fig. ", "tab_s": "Supp. Table "}[
        f"{kind}_{n[0]}"
    ] + n[1:]


rule inventory:
    """Write INVENTORY.tsv: every bundled file with its size, SHA-256, the display
    items that read it, and the description, source and licence given in
    config/figure_inputs_annotation.tsv (first matching pattern). With
    `--config checksums=false` the sha256 column is left as the empty-input hash."""
    run:
        import csv, fnmatch, hashlib, os

        producer = {str(f): r for r in workflow.rules for f in r.output}

        def externals(rule, seen):
            found = set()
            for f in map(str, rule.input):
                if f not in producer:
                    found.add(f)
                elif producer[f].name not in seen:
                    seen.add(producer[f].name)
                    found |= externals(producer[f], seen)
            return found

        used_by = {}
        for k in ITEMS:
            for f in externals(workflow.get_rule(k), {k}):
                used_by.setdefault(f, []).append(item_label(k))

        with open("config/figure_inputs_annotation.tsv") as fh:
            notes = list(csv.DictReader(fh, delimiter="\t"))
        unmatched, hit = [], set()
        rows = []
        for p in sorted(EXTERNAL):
            if p.startswith(("metadata/", "scripts/", "config/")):
                continue
            note = next((n for n in notes if fnmatch.fnmatch(p, n["pattern"])), None)
            if note is None:
                unmatched.append(p)
                continue
            hit.add(note["pattern"])
            sha = hashlib.sha256()
            if config.get("checksums", True):
                with open(p, "rb") as fh:
                    for block in iter(lambda: fh.read(1 << 20), b""):
                        sha.update(block)
            rows.append([
                p, os.path.getsize(p), sha.hexdigest(), note["category"],
                note["description"], "; ".join(used_by.get(p, [])),
                note["source"], note["licence"],
                "yes" if EXTERNAL[p] else "",
            ])
        if unmatched:
            raise ValueError("no annotation pattern matches: " + ", ".join(unmatched))
        for n in notes:
            if n["pattern"] not in hit:
                print(f"warning: annotation pattern matches no file: {n['pattern']}")
        with open("INVENTORY.tsv", "w", newline="") as fh:
            w = csv.writer(fh, delimiter="\t", lineterminator="\n")
            w.writerow(["path", "size_bytes", "sha256", "category", "description",
                        "used_by", "source", "licence", "review"])
            w.writerows(rows)
        print(f"wrote INVENTORY.tsv: {len(rows)} files, {sum(r[1] for r in rows) / 1e9:.2f} GB")


# Data-free rules naming each software environment, so that
# `snakemake --containerize containerize` (make dockerfile) can collect the
# environments without any inputs present.
rule env_figures:
    output:
        temp(touch("logs/figures/.env_figures")),
    conda:
        ENV
    shell:
        "true"


rule env_scverse:
    output:
        temp(touch("logs/figures/.env_scverse")),
    conda:
        SC_ENV
    shell:
        "true"


rule containerize:
    input:
        rules.env_figures.output,
        rules.env_scverse.output,


rule download_inputs:
    """Fetch the public summary-statistics bundle and verify checksums."""
    localrule: True
    params:
        url=config["bundle_url"],
    shell:
        "bash scripts/0-preprocess/download_figure_bundle.sh {params.url:q}"


