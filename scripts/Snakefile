# Rebuild every manuscript figure and table from summary-level inputs.
#
#   make fig-m3     Main Figure 3              -> figures/fig-m3.{pdf,png}
#   make fig-e3     Extended Data Figure 3     -> figures/fig-e3.{pdf,png}
#   make fig-s3     Supplementary Figure 3     -> figures/fig-s3.{pdf,png}
#   make tab-s3     Supplementary Table 3      -> tables/tab-s3.tsv
#
# The Makefile is a thin front door to this file; run from the repository root:
#   snakemake --snakefile scripts/Snakefile --cores 1 --sdm conda fig_m3
#
# Layout:
#   * one *producer* rule per script, declaring everything it reads and writes;
#   * one *item* rule per manuscript figure/table (fig_mN, fig_eN, fig_sN, tab_sN)
#     that simply requests the item's files;
#   * steps that read raw single-cell or genotype data are only defined with
#     `--config restricted=true`; otherwise their outputs are taken from the
#     public summary-statistics bundle (see config/figures.yaml).
#
# Every external input is declared with ext(), which also records it for the
# bundle manifest (`make manifest` -> config/figure_inputs.txt).

configfile: "config/figures.yaml"

containerized: config["container"]

RESTRICTED = bool(config.get("restricted", False))
ENV = "../workflow/envs/figures.yaml"
SC_ENV = "../workflow/envs/scverse.yaml"

# --- helpers --------------------------------------------------------------------

EXTERNAL = {}  # path -> review note ("" if none); written to the bundle manifest


def ext(*paths, review=""):
    """Declare external (bundle) inputs; `review` flags files to confirm before deposit."""
    for p in paths:
        EXTERNAL.setdefault(p, review)
    return list(paths)


def bundled(*paths, review=""):
    """Outputs of restricted steps: built here with restricted=true, else from the bundle."""
    return [] if RESTRICTED else ext(*paths, review=review)


def figs(*ids):
    return [f"figures/fig-{i}.{e}" for i in ids for e in ("pdf", "png")]


def tabs(*ids):
    return [f"tables/tab-{i}.tsv" for i in ids]


def panels(folder, *names):
    return [f"figures/panels/{folder}/{n}" for n in names]


def log(name):
    return f"logs/figures/{name}.log"


R = "Rscript {params.script} > {log} 2>&1"


META = ext(
    "metadata/cell.tsv",
    "metadata/trait.tsv",
    "metadata/trait_category.tsv",
    "metadata/gencode.v44.gene_type.tsv.gz",
)
LABELS = ext("metadata/table_column_names.xlsx")
V5 = ext("results/preprocessed/tenk10k_phase1.v5.parquet.gz")
MAGMA = ext("results/aggregate/tenk10k_phase1.magma.gz.parquet")

# everything scripts/0-preprocess/preprocess_results.R reads
PREPROCESS = (
    ["scripts/0-preprocess/preprocess_results.R"]
    + META
    + V5
    + MAGMA
    + ext(
        "results/aggregate/eqtlgen2020.msmr.parquet.gz",
        "results/aggregate/coloc/tenk10k_phase1.coloc.v3.parquet.gz",
        "results/aggregate/coloc/tenk10k_phase1.mvcoloc.parquet.gz",
    )
)
WRITE_TABLE = ["scripts/util/write_table.R"] + LABELS

