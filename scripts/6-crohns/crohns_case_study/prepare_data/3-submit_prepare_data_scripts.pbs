project_dir=/g/data/fy54/rt3501/repos/tenk10k-causal
logs_dir=${project_dir}/scripts/crohns_case_study/logs

conda activate tidyverse

script=${project_dir}/scripts/crohns_case_study/prepare_data/1-prepare_external_source_annot_boolean_df.R
log=${logs_dir}/1-prepare_external_source_annot_boolean_df.log

script2=${project_dir}/scripts/crohns_case_study/prepare_data/2-postprocess.R
log2=${logs_dir}/2-postprocess.log

/usr/bin/time Rscript ${script} >> ${log} 2>&1
/usr/bin/time Rscript ${script2} >> ${log2} 2>&1