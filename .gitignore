# Ignore Python cache and temp files
__pycache__/
*.pyc
*.pyo
*.pyd
*.tmp
*.temp
*.log
*.out
*.bak

# Ignore R temp and log files
*.Rhistory
*.RData
*.Rproj.user/
*.Rout
*.Rout.save
*.Rapp.history
*.Rcheck/

# Ignore Snakemake temp and log files
.snakemake/
*.snakemake.log
*.snakemake.tmp
*.snakemake.out

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore results and intermediate files
results/
logs/
*.gz
*.parquet
*.tsv
*.csv
*.xlsx
*.h5
*.h5ad
*.bed
*.bim
*.fam
*.chain
*.done
*.touch
*.zip
*.tar
*.tar.gz
*.egg-info/

# Ignore virtual environments
venv/
.env/
env/
conda-env/

# Ignore cloud sync files
*.gdoc
*.gsheet
*.gdrawing
*.gslides

# Ignore editor and IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore conda/pip build artifacts
build/
dist/
*.egg-info/

# Ignore data files that should not be committed
data/
results/
raw_data/
*.bak
*.backup

# Ignore large files and databases
*.db
*.sqlite
*.sqlite3

# Ignore temporary analysis outputs
tmp/
temp/
scratch/

# Ignore .claude
.claude/
# --- Exceptions -------------------------------------------------------------
# The blanket data patterns above (*.tsv, *.csv, *.xlsx, *.gz, *.parquet) exist
# to keep results and bulk data out of the repository. The directories below
# hold small, tracked configuration and metadata that the code needs in order
# to run, so they must be exempt; without these lines the next `git add` will
# silently drop them.
!metadata/**
!config/**
!resources/misc/**
!resources/scdrs/config/**
!workflow/config/**
!workflow/envs/**
!sensitivity/config/**
